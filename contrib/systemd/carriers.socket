[Unit]
Description=carriers mailing list ingress socket

[Socket]
# Address carriers accepts inbound LMTP/SMTP on. Point your front MTA's relay
# transport at this address. When the socket is used, the `listen` value in
# carriers.toml is ignored.
ListenStream=127.0.0.1:2400

# carriers accepts connections itself from the single listening socket, so do not
# spawn a service instance per connection.
Accept=no

[Install]
WantedBy=sockets.target
